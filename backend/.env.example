APP_NAME=JobConnect
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-url.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ────────────────────────────────────────────────
# For Railway MySQL: copy the values from your Railway service variables
DB_CONNECTION=mysql
DB_HOST=your-db-host.railway.internal
DB_PORT=3306
DB_DATABASE=jobconnect
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# ── CORS / Frontend ─────────────────────────────────────────
# Set to your Vercel deployment URL (no trailing slash).
# Multiple origins: comma-separated, e.g. https://app.vercel.app,https://www.yourdomain.com
FRONTEND_URL=https://your-app.vercel.app

# ── Storage ─────────────────────────────────────────────────
# Use 'public' so uploaded files (logos, CVs) are web-accessible
FILESYSTEM_DISK=public

# ── Session ─────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Mail (optional) ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@jobconnect.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (optional — leave blank if not using S3) ─────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
