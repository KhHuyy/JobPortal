# ============================================================
# JobConnect Frontend — Environment Variables
# ============================================================
# Copy this file to .env.local for local development or
# set these variables in your Vercel project settings for production.

# Backend API base URL (must include /api suffix)
# Local:      http://127.0.0.1:8000/api  (default when this var is unset)
# Production: https://your-backend-url.up.railway.app/api
VITE_API_URL=https://your-backend-url.up.railway.app/api
